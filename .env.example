# ── Social Leaker configuration ─────────────────────────────────────
# Copy this file to ".env" and adjust the values.

# --- App ---
APP_NAME=Social Leaker
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

# Secret used to sign session/JWT tokens. CHANGE THIS in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-please-use-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
DATABASE_URL=sqlite:///./data/socialleaker.db

# --- First admin user (created on `python -m socialleaker.cli init`) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Collection engine safeguards ---
# Delay (seconds) between requests to respect platform rate limits.
SCRAPE_MIN_DELAY=2.5
SCRAPE_MAX_DELAY=6.0
# Safety ceiling of profiles collected per task.
SCRAPE_MAX_ITEMS=2000
# Adaptive backoff when the platform throttles us (seconds) and retry count.
SCRAPE_BACKOFF_BASE=20.0
SCRAPE_BACKOFF_MAX=600.0
SCRAPE_RETRIES=5

# --- Instagram credentials (optional, only for authenticated collection) ---
# Leave blank to run in anonymous/public-only mode.
IG_USERNAME=
IG_PASSWORD=
# Path where the Instagram session is cached to avoid re-login.
IG_SESSION_FILE=./data/ig_session.json

# --- Claude Code ACP bridge ---
# Command that launches Claude Code as an ACP (Agent Client Protocol) agent.
# Requires Node.js and the adapter installed globally:
#     npm install -g @zed-industries/claude-code-acp
# (or use "npx -y @zed-industries/claude-code-acp" — slower on first run).
# The connection reuses your existing Claude Code login (~/.claude).
ACP_AGENT_CMD=claude-code-acp
# Working directory the agent operates in.
ACP_CWD=.
# Auto-approve agent tool-permission requests (true) or forward to the UI (false).
ACP_AUTO_APPROVE=true
